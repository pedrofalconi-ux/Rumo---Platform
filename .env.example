# LLM — itinerary generation
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=8192
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Uber deep-link client id for ride buttons in itinerary cards
NEXT_PUBLIC_UBER_CLIENT_ID=

# App mobile (apps/mobile/.env) — IP da maquina na rede local em dev,
# dominio publicado do dashboard em producao.
EXPO_PUBLIC_API_URL=http://192.168.0.99:3000

# Origens extra liberadas no CORS para o Expo Web (apps/web/proxy.ts).
# Portas 8081 e 19006 em localhost/LAN ja sao liberadas automaticamente.
MOBILE_WEB_ORIGINS=
